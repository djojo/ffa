{{!
    @template theme_remui/smartch_info
}}


{{! modification smartch dashboard}}

<h3 class="FFF-title1" style="margin-top:50px;">

    <span class="FFABlack FFF-Blue" style="letter-spacing:1px;">{{title1}}</span><span class="FFABlack FFF-Gold" style="letter-spacing:1px;">{{title2}}</span> 
    {{! <svg class="fff-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M11 14H10V10H9M10 6H10.01M19 10C19 14.9706 14.9706 19 10 19C5.02944 19 1 14.9706 1 10C1 5.02944 5.02944 1 10 1C14.9706 1 19 5.02944 19 10Z" stroke="#00315a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg> }}

</h3>

<div class="row" id="coursescore"  style="width: 100vw;
    position: absolute;">

    <div class="col-sm-12 col-md-6 col-lg-3">
        <div class="fff-box-stats" style="border-right: 1px solid #00315a;padding-left: 80px;">
            {{! <h1>-</h1> }}
            <h1>{{timespent}}</h1>
            <h5>Temps <br/> passé</h5>
        </div>
    </div>
    {{! modules terminés sauf les dossiers  }}
    <div class="col-sm-12 col-md-6 col-lg-3">
        <div class="fff-box-stats" style="border-right: 1px solid #00315a;">
            <h1>{{progress}}%</h1>
            <h5>De progression générale</h5>
        </div>
    </div>
    {{! modules terminés avec les plannings passés  }}
    <div class="col-sm-12 col-md-6 col-lg-3">
        <div class="fff-box-stats" style="border-right: 1px solid #00315a;">
            <h1>{{modulesfinished}}</h1>
            <h5>Activité(s) terminée(s)</h5>
        </div>
    </div>
    <div class="col-sm-12 col-md-6 col-lg-3">
        <div class="fff-box-stats">
            <h1>{{modulestocome}}</h1>
            <!--<h1>{{responses}}%</h1>-->
            <h5>Activité(s) restantes(s)</h5>
        </div>
    </div>
    
    

</div>

<div id="blockstatsresponsive"></div>